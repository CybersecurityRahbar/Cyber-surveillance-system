# Local development configuration. Do not commit camera credentials or passwords.
TRAFFIC_SURVEILLANCE_ENVIRONMENT=development
TRAFFIC_SURVEILLANCE_HOST=127.0.0.1
TRAFFIC_SURVEILLANCE_PORT=8000
TRAFFIC_SURVEILLANCE_DATABASE=data/surveillance.sqlite3
TRAFFIC_SURVEILLANCE_API_KEY=

TRAFFIC_SURVEILLANCE_LAB_STORAGE_DIR=data/lab
TRAFFIC_SURVEILLANCE_MODEL_PATH=yolo26n.pt
# Optional Ultralytics classification weights trained with fine-grained vehicle make/model labels.
# Leave empty until you have a suitable and properly licensed model.
TRAFFIC_SURVEILLANCE_VEHICLE_MODEL_PATH=
TRAFFIC_SURVEILLANCE_MAX_UPLOAD_MB=1024
