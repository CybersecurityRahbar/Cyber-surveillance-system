# Copy to .env for local development. Never commit real secrets.
CYBER_SURVEILLANCE_ENVIRONMENT=development
CYBER_SURVEILLANCE_HOST=127.0.0.1
CYBER_SURVEILLANCE_PORT=8000
# Required when binding beyond loopback or using production.
CYBER_SURVEILLANCE_API_KEY=
CYBER_SURVEILLANCE_MAX_MEMORY_EVENTS=10000
CYBER_SURVEILLANCE_AUTH_FAILURE_THRESHOLD=5
CYBER_SURVEILLANCE_AUTH_FAILURE_WINDOW_SECONDS=300
